{#
/**
 * @file
 * Interstate-8 page template — wires the site-header and site-footer SDC
 * components (INT8-015) around the regions declared in interstate_85.info.yml.
 *
 * @see html.html.twig
 */
#}
<div class="layout-container">

  {% embed 'interstate_85:site-header' with { variant: header_variant|default('solid'), page: page } only %}
    {% block branding %}{{ page.header }}{% endblock %}
    {% block nav %}{{ page.primary_menu }}{% endblock %}
  {% endembed %}

  {# INT8-028: the page-header hero — a sibling of header/footer, so it spans
     the full --sheet-max width like they do, rather than the --content-max cap
     inside .layout-content below. Its two halves are two ordinary blocks
     placed in the page_header region (core's page-title block, and the
     `page_hero` content block holding the background images); the theme just
     drops each into the matching hero slot. `page_hero` is empty on any route
     neither block is visible on — the homepage — so no hero renders there.
     @see interstate_85_preprocess_page() #}
  {% if page_hero %}
    {# No `only`: it would also cut the blocks below off from the outer scope,
       not just the component's own render (the INT8-018 quirk). #}
    {% embed 'interstate_85:hero' with { variant: 'page-title' } %}
      {% block image %}{{ page_hero.image }}{% endblock %}
      {% block title %}{{ page_hero.title }}{% endblock %}
    {% endembed %}
  {% endif %}

  <main class="site-main">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}

    <div class="layout-content">
      {{ page.breadcrumb }}

      {# INT8-019 review round 2, revised: sidebar_first and sidebar_second
         are one row, in reading order — first, then the main content, then
         second — so "first" genuinely comes first in the markup, matching
         the names. Neither sidebar_first nor page.content gets an extra
         wrapper div; only each sidebar's own <aside> landmark wraps
         anything, exactly as page.content and sidebar_first were unwrapped
         before this region existed. The row's modifier class appears only
         when a sidebar is actually placed, so every route with neither
         populated (i.e. everything except the song page today) keeps
         today's plain single-column layout untouched.

         `page.sidebar_first` is truthy even with NO block placed in it —
         Drupal still emits a (contentless) render array for a declared,
         empty region, which Twig sees as a non-empty array. A bare
         `{% if page.sidebar_first %}` therefore rendered an empty <aside> on
         every page, which — worse — made the grid below see three items
         instead of two and auto-wrap the real sidebar onto its own implicit
         row, far down the page (caught in review: the rail rendered
         detached from the main content entirely). `|render|trim` asks
         whether there is any actual OUTPUT, the same idiom already used for
         empty field detection in node--song--full.html.twig.

         sidebar_first has no content anywhere on the site yet; the grid
         below is sized for the one combination that is real (main + second)
         rather than speculatively generalised for a combination nothing
         renders. #}
      {% set sidebar_first = page.sidebar_first|render|striptags|trim %}
      {% set sidebar_second = page.sidebar_second|render|striptags|trim %}
      <div class="layout-content__row{{ (sidebar_first or sidebar_second) ? ' layout-content__row--with-rail' : '' }}">
        {% if sidebar_first %}
          <aside class="layout-sidebar-first">{{ page.sidebar_first }}</aside>
        {% endif %}

        {{ page.content }}

        {% if sidebar_second %}
          <aside class="layout-sidebar-second">{{ page.sidebar_second }}</aside>
        {% endif %}
      </div>
    </div>{# /.layout-content #}
  </main>

  {{ include('interstate_85:site-footer', {}, with_context: false) }}

</div>{# /.layout-container #}

{#
/**
 * @file
 * Interstate-8 page template — wires the site-header and site-footer SDC
 * components (INT8-015) around the regions declared in interstate_85.info.yml.
 *
 * @see html.html.twig
 */
#}
<div class="layout-container">

  {% embed 'interstate_85:site-header' with { variant: header_variant|default('solid'), page: page } only %}
    {% block branding %}{{ page.header }}{% endblock %}
    {% block nav %}{{ page.primary_menu }}{% endblock %}
  {% endembed %}

  {# INT8-028: the page-header hero — a sibling of header/footer, so it spans
     the full --sheet-max width like they do, rather than the --content-max cap
     inside .layout-content below. Its two halves are two ordinary blocks
     placed in the page_header region (core's page-title block, and the
     `page_hero` content block holding the background images); the theme just
     drops each into the matching hero slot. `page_hero` is empty on any route
     neither block is visible on — the homepage — so no hero renders there.
     @see interstate_85_preprocess_page() #}
  {% if page_hero %}
    {# No `only`: it would also cut the blocks below off from the outer scope,
       not just the component's own render (the INT8-018 quirk). #}
    {% embed 'interstate_85:hero' with { variant: 'page-title' } %}
      {% block image %}{{ page_hero.image }}{% endblock %}
      {% block title %}{{ page_hero.title }}{% endblock %}
    {% endembed %}
  {% endif %}

  <main class="site-main">
    <a id="main-content" tabindex="-1"></a>{# link is in html.html.twig #}

    <div class="layout-content">
      {{ page.breadcrumb }}

      {# INT8-019 review round 2: sidebar_second is a real rail next to the
         main content (song page: the "coming soon" block), so it forms a
         two-column row with page.content rather than stacking full-width —
         the modifier class only appears when something is actually placed
         there, so every route with no sidebar_second block keeps today's
         plain single-column layout untouched. sidebar_first has no content
         anywhere on the site yet and is deliberately left as it was
         (stacked below, unstyled) rather than speculatively building the
         same two-column treatment for a region nothing uses. #}
      <div class="layout-content__row{{ page.sidebar_second ? ' layout-content__row--with-rail' : '' }}">
        <div class="layout-content__main">{{ page.content }}</div>
        {% if page.sidebar_second %}
          <aside class="layout-sidebar-second">
            {{ page.sidebar_second }}
          </aside>
        {% endif %}
      </div>
    </div>{# /.layout-content #}

    {% if page.sidebar_first %}
      <aside class="layout-sidebar-first">
        {{ page.sidebar_first }}
      </aside>
    {% endif %}
  </main>

  {{ include('interstate_85:site-footer', {}, with_context: false) }}

</div>{# /.layout-container #}

<?php

/**
 * @file
 * Interstate 8 theme hooks.
 */

declare(strict_types=1);

use Drupal\Core\Render\Element;
use Drupal\Core\Url;
use Drupal\i8_services\Plugin\views\sort\ArticleInsensitiveTitle;

/**
 * Implements hook_preprocess_HOOK() for menu--main.html.twig.
 *
 * Renders the active trail as a current-section marking (INT8-031, FR-16/NFR-1).
 *
 * Core knows which section we are in — `in_active_trail`, from the route match
 * — but never renders it here: this theme is `base theme: false`, so it gets
 * core's bare `system/templates/menu.html.twig` rather than starterkit's, which
 * would have added `menu-item--active-trail`. The only thing that does mark
 * links is `ActiveLinkResponseFilter` (and its client-side twin
 * `active-link.js`), which matches the link's `data-drupal-link-query` against
 * the request's query *exactly* — right for a pager, wrong for a section, so
 * the marking vanished the moment the Songs filters added `?type=…`.
 *
 * So: take the signal core already has and put it in the markup. Setting both
 * `is-active` and `aria-current` is what lets the existing CSS and the
 * accessibility contract stay untouched — they are exactly what core's own
 * marker sets, on the same element.
 *
 * Two things this deliberately leaves to others:
 * - **Descendant paths** (`/songs/<song>`) come from `menu_trail_by_path`,
 *   which extends the trail down the URL hierarchy. Core's trail is *route*-
 *   based, so a song page (`entity.node.canonical`) never matches the Songs
 *   link (`view.songs.page_1`) however much the URLs nest.
 * - **The front page**, which `ActiveLinkResponseFilter` already handles via
 *   `isFrontPage()` — and being a response filter it runs after render caching,
 *   per request, so it needs no cache context. Re-doing it here would.
 *
 * Only top-level items are marked, and that is the point: `in_active_trail` is
 * true for an active child's ancestor, so the top level is exactly "which
 * section am I in".
 */
function interstate_85_preprocess_menu__main(array &$variables): void {
  foreach ($variables['items'] as &$item) {
    if (empty($item['in_active_trail']) || !$item['url'] instanceof Url) {
      continue;
    }

    // Mark the <a>, not the <li>: the CSS keys the desktop underline off the
    // anchor, and the mobile left-border off `li:has(a[aria-current="page"])`
    // — putting the class on the <li> would give it a stray border.
    // LinkGenerator renders a Url's `attributes` option onto the anchor.
    $attributes = $item['url']->getOption('attributes') ?? [];
    $classes = $attributes['class'] ?? [];
    if (!in_array('is-active', $classes, TRUE)) {
      $classes[] = 'is-active';
    }
    $attributes['class'] = $classes;
    $attributes['aria-current'] = 'page';
    $item['url']->setOption('attributes', $attributes);
  }
  unset($item);
}

/**
 * Implements hook_preprocess_HOOK() for page.html.twig.
 *
 * Composes the page-header region's blocks into the hero SDC's two slots
 * (INT8-028): core's own page-title block supplies the `<h1>`, and the
 * `page_hero` content block supplies the background photo. Neither block
 * knows about the other — the hero is assembled here, in the theme, which is
 * where composition belongs.
 *
 * Why here and not in a `region--page-header.html.twig`: a region is rendered
 * through `#theme_wrappers`, so by the time its template runs its blocks have
 * already been flattened into one `#children` string and can no longer be
 * addressed individually. `page` is rendered through `#theme`, which hands the
 * template its regions *unrendered* — so the individual blocks are still there
 * to pick apart. (See Renderer::doRender(): the `#theme` branch is called
 * before children are rendered, the `#theme_wrappers` branch after.)
 *
 * Blocks are routed by plugin, not by placement ID, so re-placing or renaming
 * either block cannot silently empty a slot.
 */
function interstate_85_preprocess_page(array &$variables): void {
  $region = $variables['page']['page_header'] ?? [];
  $hero = ['image' => [], 'title' => []];

  foreach (Element::children($region) as $key) {
    $slot = ($region[$key]['#base_plugin_id'] ?? '') === 'page_title_block' ? 'title' : 'image';
    $hero[$slot][] = $region[$key];
  }

  $variables['page_hero'] = ($hero['image'] || $hero['title']) ? $hero : [];

  // The region's blocks are rendered through the hero above, so the region
  // must not render itself as well — that would output every one of them
  // twice. Dropping it also removes the redundant region wrapper div.
  unset($variables['page']['page_header']);
}

/**
 * Implements hook_preprocess_HOOK() for views-view--songs.html.twig.
 *
 * Takes the Songs landing (INT8-018) fully over from Views' default field
 * rendering: builds the letter-rail/grouped ledger and the filter bar's
 * current state from the raw result set and the request, matching
 * `1B.dc.html`'s SONGS LANDING composition. The View itself only has to
 * select, filter and sort the right rows (see i8_services' custom sort/
 * filter plugins) — none of its own field/row markup is used here.
 */
function interstate_85_preprocess_views_view__songs(array &$variables): void {
  $view = $variables['view'];
  $request = \Drupal::request();
  $type = $request->query->get('type', 'Modest Mouse');
  $alt = $request->query->get('alt', '1');

  $songs = [];
  foreach ($view->result as $row) {
    $node = $row->_entity;
    if (!$node) {
      continue;
    }
    $title = $node->label();
    $songs[] = [
      'title' => $title,
      'url' => $node->toUrl()->toString(),
      'is_alt' => !$node->get('field_parent_song')->isEmpty(),
      // INT8-029: the shared bucket rule, not a literal first-character —
      // see ArticleInsensitiveTitle::bucket() for why (numbers/symbols get
      // a single "#" catch-all instead of scattering as one-off groups).
      'letter' => ArticleInsensitiveTitle::bucket($title),
      'comparison_key' => ArticleInsensitiveTitle::comparisonKey($title),
    ];
  }

  // INT8-029: the View's own SQL order is only a "good enough" baseline (see
  // ArticleInsensitiveTitle's class docblock — a real PDO/MariaDB limitation
  // rules out replicating the full bucket rule in SQL) — this re-sort over
  // the already-fetched, unpaginated result set (FR-7: no pager, so it is
  // always the complete set) is the definitive order, and it is the same
  // canonical rule the grouping below uses, so the two cannot disagree.
  // usort() is stable as of PHP 8.0, so equal keys keep the View's own
  // relative order rather than shuffling arbitrarily.
  usort($songs, function (array $a, array $b): int {
    $rank = fn (string $letter): int => $letter === '#' ? 1 : 0;
    return [$rank($a['letter']), $a['comparison_key']] <=> [$rank($b['letter']), $b['comparison_key']];
  });

  // INT8-030: the anchor id for a bucket. Computed here, once, and handed to
  // *both* the group headers and the rail entries below, so the link and its
  // target cannot drift apart — song-ledger.twig only ever prints an id it
  // was given, and never builds one by string-mangling in Twig.
  //
  // The "#" bucket gets an explicitly non-"#" slug: a literal "#" in a
  // fragment identifier has to be percent-encoded and is a needless trap.
  $bucket_id = static fn (string $letter): string => 'songs-' . ($letter === '#' ? 'other' : mb_strtolower($letter));

  $groups = [];
  foreach ($songs as $song) {
    $last_key = array_key_last($groups);
    if ($last_key === NULL || $groups[$last_key]['letter'] !== $song['letter']) {
      $groups[] = [
        'letter' => $song['letter'],
        'id' => $bucket_id($song['letter']),
        'songs' => [],
      ];
      $last_key = array_key_last($groups);
    }
    $groups[$last_key]['songs'][] = $song;
  }

  // INT8-029: the rail runs A–Z then a trailing "#", matching bucket()'s own
  // ordering (SQL sorts the same way, so consecutive same-letter rows are
  // never split into two groups by this sequential pass).
  $present_letters = array_unique(array_column($songs, 'letter'));
  $rail_letters = [];
  foreach (array_merge(range('A', 'Z'), ['#']) as $letter) {
    $rail_letters[] = [
      'letter' => $letter,
      'present' => in_array($letter, $present_letters, TRUE),
      // INT8-030: same derivation as the group header's own id above, so a
      // present letter's link always resolves. Absent letters carry one too
      // and simply never render it — nothing to point at.
      'id' => $bucket_id($letter),
    ];
  }

  $type_options = [
    ['value' => 'All', 'label' => t('All'), 'selected' => $type === 'All'],
  ];
  $terms = \Drupal::entityTypeManager()->getStorage('taxonomy_term')->loadByProperties(['vid' => 'song_type']);
  uasort($terms, fn ($a, $b) => $a->getWeight() <=> $b->getWeight());
  foreach ($terms as $term) {
    $type_options[] = [
      'value' => $term->label(),
      'label' => $term->label(),
      'selected' => mb_strtolower($term->label()) === mb_strtolower((string) $type),
    ];
  }

  $current_route_query = ['type' => $type];
  $variables['results_count'] = count($songs);
  $variables['song_groups'] = $groups;
  $variables['rail_letters'] = $rail_letters;
  $variables['is_empty'] = empty($songs);
  $variables['reset_url'] = Url::fromRoute('view.songs.page_1')->toString();
  $variables['filter_bar'] = [
    'action' => Url::fromRoute('view.songs.page_1')->toString(),
    'type_options' => $type_options,
    'alt_value' => $alt,
    'alt_show_url' => Url::fromRoute('view.songs.page_1', [], ['query' => $current_route_query + ['alt' => '1']])->toString(),
    'alt_hide_url' => Url::fromRoute('view.songs.page_1', [], ['query' => $current_route_query + ['alt' => '0']])->toString(),
    'alt_selected' => $alt === '0' ? 'b' : 'a',
  ];
}
